LEADENGINE_API_KEY=change-me
LEADENGINE_DB=leadengine.db
# Agency identity — printed on every outreach draft (RERA/DLD advertising rules)
AGENCY_NAME=Acme Real Estate LLC
AGENT_NAME=Sara Ahmed
AGENT_BRN=12345
TRAKHEESI_PERMIT=
# Compliance (conservative defaults; confirm with UAE counsel)
RETENTION_DAYS_PUBLIC=90
RETENTION_DAYS_OPTIN=730
CONTACT_HOUR_START=9
CONTACT_HOUR_END=20
DNC_FILE=./dncr_export.txt
# Number of reverse proxies appending to X-Forwarded-For (0 = ignore the header; required for correct rate limiting behind a proxy)
TRUSTED_PROXIES=0
# Public lead-capture widget (<script src=".../widget.js"> + <div id="digitalburj-leads">)
CAPTURE_ORIGINS=https://www.your-agency.ae
PUBLIC_URL=https://leads.your-agency.ae
# WhatsApp Cloud API — replies only to people who message first; sending stays OFF (dry-run) until enabled
WHATSAPP_SEND_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Market/legal rates used by the calculators — indicative defaults, VERIFY current rules before quoting clients
GOLDEN_VISA_MIN_AED=2000000
DLD_PCT=4.0
AGENCY_PCT=2.0
DEFAULT_LTV_PCT=80
DEFAULT_RATE_PCT=4.5
# Reddit official API (script app: reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=uae-lead-engine/1.0 (contact: you@example.com)
# Meta Lead Ads (Facebook + Instagram)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
# Signed generic webhook (TikTok / LinkedIn / website forms via Zapier, Make or native)
FORM_WEBHOOK_SECRET=
# Licensed data provider for public LinkedIn/FB/IG/TikTok data
APIFY_TOKEN=

# ---- Platform mode (accounts, workspaces, marketing site, dashboard). Leave CONTROL_DB empty for the single-tenant app above.
CONTROL_DB=./data/control.db
DATA_DIR=./data
# Fernet key that encrypts per-workspace integration secrets. Generate: python -c "from leadengine.platform.security import generate_key; print(generate_key())"
ENCRYPTION_KEY=
# Public base URL (used in e-mail links, canonical URLs and the widget snippet)
BASE_URL=http://127.0.0.1:8000
# Session cookies are Secure unless this is 1 (local http only). With 1, the console mailer also logs e-mail bodies so you can click verify/reset links.
DEV_INSECURE_COOKIES=0
# open = anyone can create a workspace; invite = only invited people (create the first owner with: python -m leadengine.cli create-owner)
SIGNUP_MODE=open
MAIL_BACKEND=console
MAIL_FROM=DigitalBurj Leads <no-reply@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Shown on the public Contact page
CONTACT_EMAIL=
